# NetGuard local development configuration.
NETGUARD_PROJECT_ID=demo-app
NETGUARD_AUTH_USERNAME=admin
NETGUARD_AUTH_PASSWORD=change-me
NETGUARD_AUTH_API_KEY=

# Optional alert delivery.
NETGUARD_WEBHOOK_URL=
NETGUARD_SLACK_WEBHOOK=
NETGUARD_ALERT_EMAIL=
NETGUARD_SMTP_HOST=smtp.gmail.com
NETGUARD_SMTP_PORT=587
NETGUARD_SMTP_USER=
NETGUARD_SMTP_PASSWORD=
NETGUARD_SMTP_FROM=

# Optional runtime tuning.
NETGUARD_MODEL_DIR=models
NETGUARD_FLOW_WINDOW_SECONDS=30
NETGUARD_DASHBOARD_PATH=/netguard
NETGUARD_DASHBOARD_MODE=embedded
NETGUARD_DASHBOARD_URL=http://127.0.0.1:8787
NETGUARD_DASHBOARD_PORT=8787
NETGUARD_WEEKLY_DIGEST_ENABLED=true
NETGUARD_WEEKLY_DIGEST_DAY=sun
NETGUARD_WEEKLY_DIGEST_HOUR=9
NETGUARD_LOG_FILE=alerts.log
NETGUARD_CONSOLE_ALERTS=true